<Window x:Class="Butane.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Butane Library" Height="560" Width="820" MinWidth="560" MinHeight="360"
        Background="{StaticResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="LibraryTabs" Background="{StaticResource BgBrush}"
                    Foreground="White" BorderBrush="{StaticResource LineBrush}">
            <TabItem x:Name="BookmarksTab" Header="BOOKMARKS">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="OPEN" Width="90" Height="36" Margin="6"
                                Style="{StaticResource FlatButton}" Click="OpenBookmark_Click" />
                        <Button Content="REMOVE" Width="90" Height="36" Margin="6"
                                Style="{StaticResource FlatButton}" Click="RemoveBookmark_Click" />
                    </StackPanel>
                    <ListBox x:Name="BookmarksList" Background="Transparent" Foreground="White"
                             BorderBrush="{StaticResource LineBrush}" FontFamily="{StaticResource Mono}"
                             DisplayMemberPath="Display" MouseDoubleClick="OpenBookmark_Click" />
                </DockPanel>
            </TabItem>
            <TabItem x:Name="HistoryTab" Header="HISTORY">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="OPEN" Width="90" Height="36" Margin="6"
                                Style="{StaticResource FlatButton}" Click="OpenHistory_Click" />
                        <Button Content="REMOVE" Width="90" Height="36" Margin="6"
                                Style="{StaticResource FlatButton}" Click="RemoveHistory_Click" />
                        <Button Content="CLEAR HISTORY" Width="140" Height="36" Margin="6"
                                Style="{StaticResource FlatButton}" Click="ClearHistory_Click" />
                    </StackPanel>
                    <ListBox x:Name="HistoryList" Background="Transparent" Foreground="White"
                             BorderBrush="{StaticResource LineBrush}" FontFamily="{StaticResource Mono}"
                             DisplayMemberPath="Display" MouseDoubleClick="OpenHistory_Click" />
                </DockPanel>
            </TabItem>
            <TabItem x:Name="DownloadsTab" Header="DOWNLOADS">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="OPEN FILE" Width="105" Height="36" Margin="6"
                                Style="{StaticResource FlatButton}" Click="OpenDownload_Click" />
                        <Button Content="SHOW IN FOLDER" Width="145" Height="36" Margin="6"
                                Style="{StaticResource FlatButton}" Click="ShowDownload_Click" />
                        <Button Content="CANCEL" Width="90" Height="36" Margin="6"
                                Style="{StaticResource FlatButton}" Click="CancelDownload_Click" />
                        <Button Content="REMOVE" Width="90" Height="36" Margin="6"
                                Style="{StaticResource FlatButton}" Click="RemoveDownload_Click" />
                    </StackPanel>
                    <ListBox x:Name="DownloadsList" Background="Transparent" Foreground="White"
                             BorderBrush="{StaticResource LineBrush}" FontFamily="{StaticResource Mono}"
                             DisplayMemberPath="Display" />
                </DockPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" Margin="4,12,4,0" Foreground="{StaticResource DimBrush}"
                   FontFamily="{StaticResource Mono}" FontSize="11"
                   Text="DOUBLE-CLICK A BOOKMARK OR HISTORY ITEM TO OPEN IT." />
    </Grid>
</Window>
