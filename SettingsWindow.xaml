<Window x:Class="Butane.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Butane" Width="600" Height="720"
        MinWidth="540" MinHeight="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="White">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="SETTINGS" FontFamily="{StaticResource Mono}"
                       FontSize="22" FontWeight="Black" />
            <TextBlock Text="COOKIE AND TRACKING PROTECTION"
                       Margin="0,6,0,0" Foreground="{StaticResource DimBrush}"
                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,18">
        <StackPanel Margin="0,0,14,0">
            <CheckBox x:Name="BlockTrackersCheckBox"
                      Content="Enable Butane Shield tracker blocking"
                      Foreground="White" FontFamily="{StaticResource Mono}"
                      FontSize="13" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="Blocks requests to known tracker hosts. Site exceptions continue to apply."
                       Foreground="{StaticResource DimBrush}" TextWrapping="Wrap"
                       Margin="24,0,0,20" />

            <TextBlock Text="WEBVIEW TRACKING PREVENTION"
                       Foreground="White" FontFamily="{StaticResource Mono}"
                       FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
            <ComboBox x:Name="TrackingPreventionComboBox" Height="34"
                      Background="#222222" Foreground="White"
                      BorderBrush="{StaticResource LineBrush}" Padding="8,4">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#222222" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Padding" Value="8,5" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#3A3A3A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#333333" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="Off" />
                <ComboBoxItem Content="Basic" />
                <ComboBoxItem Content="Balanced" />
                <ComboBoxItem Content="Strict" />
            </ComboBox>
            <TextBlock Text="WebView protection is applied to normal and private windows."
                       Foreground="{StaticResource DimBrush}" TextWrapping="Wrap"
                       Margin="0,6,0,22" />

            <CheckBox x:Name="ClearCookiesOnExitCheckBox"
                      Content="Clear cookies when the last normal window closes"
                      Foreground="White" FontFamily="{StaticResource Mono}"
                      FontSize="13" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="Cookies are kept by default. This does not clear other site data or affect private windows."
                       Foreground="{StaticResource DimBrush}" TextWrapping="Wrap"
                       Margin="24,0,0,0" />

            <TextBlock Text="BROWSING" FontFamily="{StaticResource Mono}" FontSize="14" FontWeight="Black"
                       Margin="0,34,0,10" />

            <TextBlock Text="HOME PAGE (BLANK = NEW TAB PAGE)" Foreground="White"
                       FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBox x:Name="HomePageTextBox" Height="34" Background="#222222" Foreground="White"
                     CaretBrush="White" BorderBrush="{StaticResource LineBrush}" Padding="8,4"
                     VerticalContentAlignment="Center" Margin="0,0,0,18" />

            <TextBlock Text="SEARCH ENGINE" Foreground="White" FontFamily="{StaticResource Mono}"
                       FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
            <ComboBox x:Name="SearchEngineComboBox" Height="34" Background="#222222" Foreground="White"
                      BorderBrush="{StaticResource LineBrush}" Padding="8,4" Margin="0,0,0,18">
                <ComboBoxItem Content="DuckDuckGo" />
                <ComboBoxItem Content="Google" />
                <ComboBoxItem Content="Bing" />
                <ComboBoxItem Content="Brave" />
                <ComboBoxItem Content="Ecosia" />
            </ComboBox>

            <CheckBox x:Name="SearchSuggestionsCheckBox" Content="Show search suggestions in the address bar"
                      Foreground="White" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Bold"
                      Margin="0,0,0,8" />
            <TextBlock Text="Sends what you type in the address bar to your search engine to fetch suggestions."
                       Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="24,0,0,18" />

            <CheckBox x:Name="ShowBookmarksBarCheckBox" Content="Show bookmarks bar"
                      Foreground="White" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Bold"
                      Margin="0,0,0,14" />
            <CheckBox x:Name="RestoreSessionCheckBox" Content="Reopen tabs from last session on startup"
                      Foreground="White" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Bold"
                      Margin="0,0,0,14" />
            <CheckBox x:Name="SavePasswordsCheckBox" Content="Offer to save passwords"
                      Foreground="White" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Bold"
                      Margin="0,0,0,14" />
            <CheckBox x:Name="AutofillCheckBox" Content="Autofill addresses and forms"
                      Foreground="White" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Bold"
                      Margin="0,0,0,8" />
            <TextBlock Text="Password and autofill changes apply to tabs opened after saving. Not available in private windows."
                       Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="24,0,0,0" />
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CANCEL" Width="100" Height="38" Margin="0,0,10,0"
                    Click="Cancel_Click" />
            <Button Content="SAVE" Width="100" Height="38" IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
