<Window x:Class="Butane.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Butane" Height="720" Width="1100">

    <DockPanel>

        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Content="&#x25C0;" Width="34" Height="30"
                    Margin="0,0,4,0" Click="BackButton_Click" IsEnabled="False" ToolTip="Back" />
            <Button x:Name="ForwardButton" Grid.Column="1" Content="&#x25B6;" Width="34" Height="30"
                    Margin="0,0,4,0" Click="ForwardButton_Click" IsEnabled="False" ToolTip="Forward" />
            <Button x:Name="ReloadButton" Grid.Column="2" Content="&#x27F3;" Width="34" Height="30"
                    Margin="0,0,8,0" Click="ReloadButton_Click" ToolTip="Reload" />
            <TextBox x:Name="AddressBar" Grid.Column="3" Height="30" FontSize="14"
                     VerticalContentAlignment="Center" KeyDown="AddressBar_KeyDown" />
        </Grid>

        <!-- Web content -->
        <wv2:WebView2 x:Name="Web" />

    </DockPanel>
</Window>
